# Jarvis: só precisa disto se for ENVIAR email pela aba Email.
# Copie para .env (cp .env.example .env) e preencha. Passo a passo: aba Guias → "Configurar o email".
# A senha de app do Google tem 16 letras e só existe com a verificação em 2 etapas ligada.
EMAIL_USER=seuemail@gmail.com
EMAIL_APP_PASSWORD=
